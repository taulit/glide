  "type": "module",
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc --noEmit",
