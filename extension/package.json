    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@girs/gjs": "^4.1.0",
    "@girs/gnome-shell": "51.0.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
